# 検証ゲートのCI配線(潮路キット生成)。ゲート定義は CLAUDE.md §4 / project.yaml。
# guardrails は make guard / pre-commit と同一のゲート列(scripts/run_gates.py)を実行する。
name: ci
on: [push, pull_request]
jobs:
  guardrails:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install -r requirements.txt
      # 未装備のゲートは gate_status.json と Job Summary に出る。
      # ここで --strict を使わないのは、0日目は oracle も stack も未装備であり、
      # 生成直後の main が赤になってしまうため(0日目から緑の原則)。
      # 未装備の失効は project.yaml の by_task が担う。期限のタスクが done に
      # なったのに装備されていなければ、--strict なしでも赤になる。
      # --strict はリリース前・監査時に人間が明示的に実行する。
      - run: python scripts/run_gates.py
{% if stack == 'flutter' %}
  stack:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true
      - run: |
          if [ -f pubspec.yaml ]; then flutter pub get && flutter analyze && flutter test; else echo "スタック未初期化(T-001)— skip"; fi
{% elif stack == 'node' %}
  stack:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - run: |
          if [ -f package.json ]; then npm ci && npm run lint --silent && npm test --silent; else echo "スタック未初期化(T-001)— skip"; fi
{% elif stack == 'python' %}
  stack:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: |
          if [ -f pyproject.toml ]; then pip install -e ".[dev]" && ruff check . && pytest -q; else echo "スタック未初期化(T-001)— skip"; fi
{% else %}
  # スタックジョブは T-002 で配線する(project.yaml の stack 節と同じコマンドを使うこと)
{% endif %}
