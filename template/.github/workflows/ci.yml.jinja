# 検証ゲートのCI配線(潮路キット生成)。ゲート定義は CLAUDE.md §4 / project.yaml。
# guardrails / stack とも make guard / pre-commit と同一のゲート列
# (scripts/run_gates.py)を実行する。検証コマンドをここに直書きしない。
name: ci
on: [push, pull_request]
jobs:
  guardrails:
    runs-on: ubuntu-latest
    steps:
      # 保護パス検査は base..HEAD の差分を見るため、浅いクローンでは
      # 比較元を解決できず「未装備」になる。
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install -r requirements.txt
      # push では GITHUB_BASE_REF が空で、checkout が origin の既定ブランチ参照を
      # HEAD と同じ位置へ進めるため、base..HEAD が空になり何も検査されない。
      # push 前のSHAを比較元として渡す。
      # このファイルは copier(Jinja2)が描画するため、GitHub の ${'{{'} ... {'}}'} 式は
      # 書けない(Jinja2 に解釈されてしまう)。環境変数だけで書く。
      - name: 保護パス検査の比較元を決める
        run: |
          if [ "$GITHUB_EVENT_NAME" = "push" ]; then
            before=$(jq -r '.before // ""' "$GITHUB_EVENT_PATH")
            zero=0000000000000000000000000000000000000000
            if [ -n "$before" ] && [ "$before" != "$zero" ] && git cat-file -e "$before^{commit}"; then
              echo "PROTECTED_BASE=$before" >> "$GITHUB_ENV"
            fi
          fi
      # 未装備のゲートは gate_status.json と Job Summary に出る。
      # ここで --strict を使わないのは、0日目は oracle も stack も未装備であり、
      # 生成直後の main が赤になってしまうため(0日目から緑の原則)。
      # 未装備の失効は project.yaml の by_task が担う。期限のタスクが done に
      # なったのに装備されていなければ、--strict なしでも赤になる。
      # --strict はリリース前・監査時に人間が明示的に実行する。
      - run: python scripts/run_gates.py
{% if stack != 'manual' %}
  stack:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
{% if stack == 'flutter' %}
      - uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true
{% elif stack == 'node' %}
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
{% endif %}
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install -r requirements.txt
      # 依存の取得は検証ではないので、manifest がある間だけ行う。
      # ここが step レベルの if: なのは意図的で、job レベルの if: とは別物である。
      # job レベルでスキップされたジョブは Success として報告され、required
      # status check に指定していてもマージを妨げない。step のスキップでは
      # ジョブ自体が走り続けるため、その穴は開かない。
{% if stack == 'flutter' %}
      - run: flutter pub get
        if: hashFiles('pubspec.yaml') != ''
{% elif stack == 'node' %}
      - run: npm ci
        if: hashFiles('package.json') != ''
{% elif stack == 'python' %}
      - run: pip install -e ".[dev]"
        if: hashFiles('pyproject.toml') != ''
{% endif %}
      # 検証そのものは run_gates.py が判定する。
      # ready_marker が無い間は「未装備」と報告され、期限(project.yaml の
      # stack.by_task)を過ぎていれば赤になる。
      # 以前はここに `if [ -f ... ]; then ...; else echo "skip"; fi` と書いていたが、
      # これは検証を飛ばして成功する経路であり、期限も評価されなかった。
      - run: python scripts/run_gates.py --all
{% else %}
  # スタックジョブは T-002 で配線する。
  # 検証コマンドは project.yaml の stack 節に書き、ここでは
  # `python scripts/run_gates.py --all` を呼ぶだけにすること
  # (ローカルとCIで別のコマンドを持たない — PROCESS.md §5-4)。
{% endif %}
