#!/bin/sh
# pre-commit: guard赤のコミットを機械的に拒否する(CLAUDE.md §8 / PROCESS.md §5-4)
# makeが無い環境(Windowsネイティブ等)ではvenvのpythonでゲート列を直接実行する。
# Windows cp932でのUnicodeEncodeError回避のためUTF-8を強制。
PYTHONUTF8=1
export PYTHONUTF8
run_guard() {
  # Windows では make を使わない。Makefile は .venv/bin/python を前提にしており
  # (CLAUDE.md §8 が「Windowsネイティブでは make を使わない」と定めている)、
  # Git Bash に make があると壊れた経路を選んでしまう。
  # Windows_NT と明示的に比べる。非空かどうかで見ると、OS を別の値で
  # 輸出している Linux/macOS を Windows と誤判定し、venv 未作成のまま
  # 直接 python を呼んで pyyaml 不足で落ちる。
  if [ "$OS" != "Windows_NT" ] && command -v make >/dev/null 2>&1; then
    make guard
  else
    PYBIN=python
    [ -x .venv/bin/python ] && PYBIN=.venv/bin/python
    [ -x .venv/Scripts/python.exe ] && PYBIN=.venv/Scripts/python.exe
    "$PYBIN" scripts/run_gates.py
  fi
}
run_guard || { echo "pre-commit: guard赤のためコミット中止 (CLAUDE.md §8)"; exit 1; }
