# project.yaml — プロセス設定のSSoT(潮路キット生成)
# 汎用スクリプト(scripts/*.py)はこのファイルだけを読む。
# このファイル自体は scripts/check_project_config.py が検査する
# (run_gates.py が gates 列より前に無条件で実行する。下の gates には書かない)。
# 編集規則:
#   - gates への行追加・stack の調整はエージェント提案可(DECISIONS 記録)。
#   - oracle の values / pass_rate / metrics は人間が確定した後は変更禁止(CLAUDE.md §2-1)。
#   - requirements.active_spec の差し替えは仕様改版(人間)と同時にのみ行う。
#   - deprecated_reqs への追加も同上。
schema_version: 2

project: "{{ project_name }}"

# 段階。人間が進める。インセプションが終わったら development にする。
#   inception    仕様を決める段階。実装が始まっていたら赤
#   development  作る段階。仕様とスタックが決まっていなければ赤
lifecycle:
  phase: inception

requirements:
  prefix: "{{ req_prefix }}"                 # 注記形式: REQ-{{ req_prefix }}-nnn(3桁)
  # 有効な仕様書を1つだけ明示する。glob で自動選択しない
  # (文字列ソートでは v0.10 が v0.9 より前に並び、front-matter の status も見られない)。
  # 空の間、REQ整合ゲートは「未装備」として報告される(緑には数えない)。
  active_spec: ""                          # 例: docs/spec/{{ spec_slug }}_SPEC_v0.1.md

deprecated_reqs: []                        # 廃止REQ番号(整数)。例: [31, 32, 55]

layers:
  src: [lib, src]                          # 実装層(REQ注記の実装⇔テストリンク検査対象)
  test: [test, tests]

scan_ext: [.dart, .py, .md, .yaml, .yml, .ts, .tsx, .js, .kt, .swift, .rs, .go]
l0_exempt: [CLAUDE.md, AGENTS.md]          # 廃止REQを名指しできる文書(編集は人間のみ)
scan_exclude: [docs/proposals]             # 提案は下書き(未定義/将来/却下のREQを含み得る)— REQ検査から除外

stack:
  by_task: T-001                           # done になったら ready_marker の成立を要求する(未装備の失効)
{% if stack == 'flutter' %}
  app_manifest: pubspec.yaml               # アプリ本体の依存台帳(追加は人間ゲート — CLAUDE.md §6)
  ready_marker: pubspec.yaml               # 不在の間、stack系コマンドは未装備として報告(0日目から緑)
  analyze: [[flutter, analyze]]
  test: [[flutter, test]]
{% elif stack == 'node' %}
  app_manifest: package.json
  ready_marker: package.json
  analyze: [[npm, run, lint, --silent], [npx, tsc, --noEmit]]
  test: [[npm, test, --silent]]
{% elif stack == 'python' %}
  app_manifest: pyproject.toml
  ready_marker: pyproject.toml
  analyze: [[ruff, check, .], [mypy, .]]
  test: [[pytest, -q]]
{% else %}
  app_manifest: ""                         # T-001/T-002 で設定(空の間、依存台帳ゲートは対象なし)
  ready_marker: ""                         # 空の間、stack系コマンドは常に未装備
  analyze: []
  test: []
{% endif %}

# 人間専管のもの。エージェントのコミット(CLAUDE.md §3 の `Agent:` トレーラ)が
# これらを変更していたら赤にする。
# 検出であって最終的な強制ではない — トレーラを書かなければ回避できる。
# GitHub 側の CODEOWNERS + 必須レビューと併せて置くこと(T-004)。
protected:
  by_task: T-004                           # done になったら保護の配線を要求する
  paths:
    - CLAUDE.md                            # L0 契約
    - AGENTS.md
    - docs/spec/**                         # L1 規範
    - verification/reference/**            # 参照オラクル(エージェント生成禁止)
    - test/golden/**                       # ゴールデン基準(同上)
    - requirements.txt                     # プロセス側の依存台帳
    # --- ゲート本体。エージェントのコミットが no-op 化するのを早期検出する。
    # ただし改変コミット自身が新しい検査を走らせるため、この検出は自己参照的で
    # 素朴な改変にしか効かない。最終的な強制は CODEOWNERS + 必須レビュー(T-004)。
    - Makefile                             # ローカル guard の入口
    - scripts/run_gates.py
    - scripts/check_project_config.py
    - scripts/check_lifecycle.py
    - scripts/check_protected_paths.py
    - scripts/check_structure.py
    - scripts/check_progress.py
    - scripts/check_req_links.py
    - scripts/validate_oracle.py
    - scripts/migrate_config.py            # 更新経路(REQUIRED_SECTIONS)も装置の一部
    - scripts/hooks/pre-commit
    - .github/workflows/ci.yml
    - docs/process/SHIOJI_PROCESS.md       # プロセス定義の写し(原本はキット)
{% if stack == 'flutter' %}
    - pubspec.yaml                         # アプリ本体の依存台帳
{% elif stack == 'node' %}
    - package.json
{% elif stack == 'python' %}
    - pyproject.toml
{% endif %}
  # project.yaml はパス単位で保護しない(gates への行追加・stack の調整は提案可)。
  # 節単位で、エージェントが自分を縛る設定を緩められないようにする。
  keys: [lifecycle, oracle, protected, structure, progress]

# コードの形の規範。ここが唯一の定義で、散文で層やサイズを語らない。
# 閾値は protected.keys に入れてある。エージェントが自分を縛る値を緩められない。
# 空のまま残せば未装備として報告される(T-005 が期限)。
structure:
  by_task: T-005                           # done になったら規範の記入を要求する
  max_file_lines: 400                      # 分割の目安。超えたら赤
  max_function_lines: 60                   # Python のみ(AST)
  exclude:                                 # 生成物など、規範の対象外
    - "**/*.g.dart"
    - "**/*_generated.*"
    - "**/node_modules/**"
    - "**/.venv/**"
  layers: []                               # 例: [{name: ui, path: "lib/ui/**", may_import: [domain]}]
  pure_modules: []                         # import しただけで実行が始まらないこと(Python のみ)
  pure_exempt: []                          # 枠組み上やむを得ないものを明示する
  pure_allow_calls: []                     # 定義時に呼んでよい関数(例: [Path, compile])

# 実機確認の痕跡。ゲートには原理的に見えないものがある — 新鮮で、非空で、
# しかし利用者に届くものとは別の対象を検証している場合である。
# 機械で検出できないので、人間が実機を触った痕跡を要求する。
# base..HEAD で done になったタスクだけを見る(過去を遡って責めない)。
progress:
  by_task: T-004                           # 保護の配線と同じく origin が要る
  file: docs/L3/PROGRESS.md
  task_index: TASK_INDEX.md
  marker: "確認:"                           # この語を含む行にタスクIDがあること
  exempt: []                               # 実機確認が要らないタスク(理由を DECISIONS へ)

# make guard / pre-commit / CI guardrails が同一列を実行する。
# argv 形式で、shell を経由しない。project.yaml はエージェントが編集できるため、
# そこに書かれた文字列をシェルに解釈させない。複雑な処理は scripts/*.py へ置く。
# エージェント自身を縛るゲート(設定検査・保護パス検査・構造検査)は
# ここに書かない。gates は project.yaml の中にあるため、そこに置くと
# その行を消すコミット自身が素通りしてしまう。run_gates.py が組み込みで
# 実行する。ここに書くのは成果物を検査するゲートだけ。
# run_gates.py が gates 列より前に無条件で実行する。設定を検査する仕組みを、
# 設定から消せる場所に置かないため。
gates:
  - id: req-links
    argv: [python, scripts/check_req_links.py]
  - id: oracle
    argv: [python, scripts/validate_oracle.py, --dry-run]
    cutover:                               # T-003 が done になったら自動で --gate へ切り替える
      argv: [python, scripts/validate_oracle.py, --gate]
      by_task: T-003                       # 切替の判断は人間(T-003 を done にすること)

# oracle:                                  # 精度ゲート定義(インセプション N1 で確定 — PROCESS.md §6)
#   generate: [python, scripts/generate_predictions.py]   # 毎回ここから予測を作り直す(必須)
#   reference_dir: verification/reference  # 参照オラクル(人間投入・エージェント改変禁止)
#   predictions_dir: .verification/predictions            # 生成物。gitignore 済み
#   match: ordered                         # exact(キー完全一致) | ordered(時系列整列)。未知の値は赤
#   group_by: [kind]                       # 系列を分ける列(例: 満潮H/干潮L)
#   order_by: time                         # 整列列。ISO8601("2026-07-09 17:42")または数値
#   order_tolerance: 10                    # order_by の許容(日時なら分)
#   order_window: 360                      # 対応付け探索窓(日時なら分)
#   values: {height_cm: 15.0}              # 値列 → 絶対許容誤差。未設定だと値を比較しない
#   metrics:                               # 未設定だと precision が無制限(誤検出し放題)
#     recall_min: 0.95                     # TP / 参照イベント数(取りこぼし)
#     precision_min: 0.95                  # TP / 予測イベント数(誤検出)
#   # pass_rate: 0.95                      # metrics 未設定時のみ recall_min として使う(旧式)
